# Auto-injected by Tarrs into the dev sandbox. For local dev / Vercel
# prod, paste these from your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to client. Used in route handlers / server
# actions when you need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Embedding provider (SPEC §2). First key set wins: Gemini, else Voyage,
# else a deterministic dependency-free local fallback (lexical-only, NOT
# semantic) so the pipeline runs in dev without a third party. All emit
# 1024-d to match vector(1024). After switching providers, run
# POST /v1/admin/reembed to backfill existing rows into the new space.
GEMINI_API_KEY=
# GEMINI_EMBED_MODEL=gemini-embedding-001
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3

# Gates POST /v1/admin/reembed (backfills every profile's embeddings under
# the current provider — run once after setting VOYAGE_API_KEY so old
# local-space vectors don't linger). Unset → the endpoint is disabled.
ADMIN_TOKEN=

# Optional tuning (SPEC §1 / §7). Defaults shown.
# MATCH_W1=0.5
# MATCH_W2=0.5
# Distance decay (SPEC §1): score halves every N km between two users.
# Unset → location ignored, matching is purely semantic.
# MATCH_HALF_LIFE_KM=50
# Drop recommendations scoring more than this far below the best match.
# Relative, because match_score has no meaningful zero. 0 = no filtering.
# MATCH_RELATIVE_CUTOFF=0.15
# How many random profiles to score for the calibration baseline returned
# with each recommendations page. 0 = skip the baseline.
# MATCH_BASELINE_SAMPLE=50
# RATE_LIMIT=60
# RATE_WINDOW_SECONDS=60
# CONNECTION_EXPIRY_DAYS=7
